[Version]
Signature = "$Windows NT$"
Class = "ActivityMonitor"
ClassGuid = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider = %Provider%
DriverVer = 08/30/2026,2.0.0.0
CatalogFile =
PnpLockdown = 1

[DestinationDirs]
RklFilter.CopyFiles = 12

[DefaultInstall.NTamd64]
OptionDesc = %ServiceDescription%
CopyFiles = RklFilter.CopyFiles

[DefaultInstall.NTamd64.Services]
AddService = %ServiceName%,,RklFilter.Service

[RklFilter.Service]
DisplayName = %ServiceName%
Description = %ServiceDescription%
ServiceBinary = %12%\%DriverName%.sys
Dependencies = FltMgr
ServiceType = 2
StartType = 3
ErrorControl = 1
LoadOrderGroup = "FSFilter Activity Monitor"
AddReg = RklFilter.AddRegistry

[RklFilter.AddRegistry]
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\"%InstanceName%,"Altitude",0x00000000,%InstanceAltitude%
HKR,"Instances\"%InstanceName%,"Flags",0x00010001,0x0

[RklFilter.CopyFiles]
RootkitLabFilter.sys

[SourceDisksFiles]
RootkitLabFilter.sys = 1,,

[SourceDisksNames]
1 = %DiskName%,,,

[Strings]
Provider = "RootkitLab Academic Project"
ServiceName = "RootkitLabFilter"
ServiceDescription = "RootkitLab selective file-hiding minifilter"
DriverName = "RootkitLabFilter"
DiskName = "RootkitLab Academic Installation Media"
DefaultInstance = "RootkitLabFilter Instance"
InstanceName = "RootkitLabFilter Instance"
InstanceAltitude = "370030"
